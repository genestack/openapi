{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePresets": [":ignoreModulesAndTests"],
  "schedule": ["* */2 * * 6,0"],
  "rebaseWhen": "behind-base-branch",
  "updateNotScheduled": false,
  "labels": ["renovate"],
  "packageRules": [
    {
      "description": "processors_controller_spec is the Makefile's named build context that `COPY --from` reads, not an image",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["processors_controller_spec"],
      "enabled": false
    },
    {
      "description": "Automerge non-major updates",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    }
  ]
}
